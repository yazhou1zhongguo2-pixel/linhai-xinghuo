/* 我的订单页样式 */
.orders {
  padding: 0 32rpx 60rpx;
}

.order-card {
  padding: 28rpx 32rpx;
}
.order-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}
.order-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #24432F;
  flex: 1;
  min-width: 0;
}
.order-status {
  font-size: 22rpx;
  border-radius: 8rpx;
  padding: 4rpx 14rpx;
  margin-left: 16rpx;
}
.status-ok {
  color: #3A6B4E;
  background-color: #F0F5EC;
}
.status-gray {
  color: #8A847A;
  background-color: #F5F2EA;
}
.order-meta {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}
.order-type {
  font-size: 20rpx;
  color: #C9A96A;
  border: 1rpx solid #C9A96A;
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
  margin-right: 16rpx;
}
.order-bottom {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}
.order-amount {
  font-size: 30rpx;
  font-weight: bold;
  color: #C9A96A;
}

/* 空状态（通用样式） */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 120rpx;
}
.empty-icon {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 24rpx;
}
.empty-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #24432F;
  margin-bottom: 12rpx;
}
.empty-desc {
  font-size: 24rpx;
  color: #8A847A;
  text-align: center;
  line-height: 1.7;
  margin-bottom: 32rpx;
}
.empty-btn {
  background-color: #3A6B4E;
  color: #FFFFFF;
  font-size: 26rpx;
  border-radius: 14rpx;
  padding: 0 60rpx;
}
.empty-btn::after {
  border: none;
}
