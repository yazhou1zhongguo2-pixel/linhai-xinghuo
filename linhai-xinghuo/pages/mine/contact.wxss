/* 联系客服页样式 */
.contact {
  padding: 0 32rpx 60rpx;
}
.contact-row {
  display: flex;
  justify-content: space-between;
  padding: 24rpx 8rpx;
  border-bottom: 1rpx solid #F0EBDF;
}
.contact-row:last-child {
  border-bottom: none;
}
.contact-label {
  font-size: 26rpx;
  color: #8A847A;
}
.contact-value {
  font-size: 26rpx;
  color: #2F2B26;
}

/* 反馈 */
.feedback-input {
  width: 100%;
  height: 200rpx;
  background-color: #FBFCF9;
  border: 1rpx solid #E8E2D5;
  border-radius: 14rpx;
  padding: 20rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}
.feedback-count {
  text-align: right;
  font-size: 22rpx;
  color: #B7AE9E;
  padding: 8rpx 0 16rpx;
}
.feedback-btn {
  background-color: #3A6B4E;
  color: #FFFFFF;
  font-size: 28rpx;
  border-radius: 14rpx;
}
.feedback-btn::after {
  border: none;
}
.pay-note {
  text-align: center;
  font-size: 22rpx;
  color: #B7AE9E;
  margin-top: 16rpx;
}
