/* 批次管理页样式 */
.form-page { padding: 0 32rpx 60rpx; }

.seed-import {
  margin-top: 24rpx; text-align: center; font-size: 26rpx;
  color: #8B6A4F; background-color: #FBF7EE;
  border: 1rpx dashed #C9A96A; border-radius: 14rpx;
  padding: 20rpx 0;
}

.text-input {
  background-color: #FBFCF9; border: 1rpx solid #E8E2D5; border-radius: 14rpx;
  padding: 20rpx 24rpx; font-size: 28rpx;
}
.gap { margin-top: 16rpx; }
.form-subtitle {
  font-size: 24rpx; color: #8A847A; font-weight: bold;
  margin: 24rpx 0 12rpx; padding-top: 16rpx; border-top: 1rpx solid #F0EBDF;
}
.form-note { text-align: center; font-size: 22rpx; color: #B7AE9E; margin-top: 16rpx; }
.submit-btn {
  margin-top: 24rpx; background-color: #3A6B4E; color: #FFFFFF;
  font-size: 28rpx; font-weight: bold; border-radius: 14rpx;
}
.submit-btn::after { border: none; }

.batch-card { margin-top: 24rpx; padding: 28rpx 32rpx; }
.batch-head { display: flex; justify-content: space-between; margin-bottom: 10rpx; }
.batch-name { font-size: 28rpx; font-weight: bold; color: #24432F; flex: 1; }
.batch-ops { display: flex; align-items: center; }
.batch-edit {
  font-size: 22rpx; color: #3A6B4E; border: 1rpx solid #3A6B4E;
  border-radius: 20rpx; padding: 6rpx 20rpx; margin-left: 12rpx;
}
.batch-del {
  font-size: 22rpx; color: #C0392B; border: 1rpx solid #C0392B;
  border-radius: 20rpx; padding: 6rpx 20rpx; margin-left: 12rpx;
}
.cancel-btn {
  margin-top: 16rpx; background-color: #F5F2EA; color: #8A847A;
  font-size: 26rpx; border-radius: 14rpx;
}
.cancel-btn::after { border: none; }
.batch-meta { display: flex; justify-content: space-between; }
.batch-actions { margin-top: 16rpx; }
.batch-pdf {
  text-align: center; font-size: 24rpx; color: #3A6B4E;
  background-color: #F0F5EC; border-radius: 12rpx; padding: 14rpx 0;
}
.batch-pdf-done { color: #8B6A4F; background-color: #FBF7EE; }
.empty-tip { text-align: center; font-size: 24rpx; color: #B7AE9E; padding: 40rpx 0; }
