<!-- 我的订单页"家具摆放图" -->
<view class="orders">

  <!-- 订单列表 -->
  <view class="card order-card" wx:for="{{orders}}" wx:key="orderId">
    <view class="order-top">
      <view class="order-name">{{item.name}}</view>
      <view class="order-status {{item.status === '已报名' || item.status === '认养中' ? 'status-ok' : 'status-gray'}}">
        {{item.status}}
      </view>
    </view>
    <view class="order-meta">
      <text class="order-type">{{item.type}}</text>
      <text class="text-secondary">{{item.detail}}</text>
    </view>
    <view class="order-bottom">
      <text class="text-secondary">订单号 {{item.orderId}}</text>
      <text class="order-amount">¥{{item.amount}}<text class="demo-tag">演示</text></text>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty" wx:if="{{!orders.length}}">
    <image class="empty-icon" src="/images/icon-notebook.png" mode="aspectFit"></image>
    <view class="empty-title">还没有订单</view>
    <view class="empty-desc">去预约一场研学，或认养一片林子吧</view>
    <button class="empty-btn" bindtap="goStudy">去研学看看</button>
  </view>
</view>
