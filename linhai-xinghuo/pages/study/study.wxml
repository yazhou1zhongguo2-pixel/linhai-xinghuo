<!-- 研学页"家具摆放图" -->
<view class="study">

  <!-- 顶部理念区 -->
  <view class="study-hero">
    <view class="study-hero-title">来林子里亲自看一看</view>
    <view class="study-hero-desc">线上建立信任，线下走进真实\n研学不是课堂的延伸，是林子的邀请</view>
  </view>

  <!-- 产品卡片列表 -->
  <view class="card product-card" wx:for="{{products}}" wx:key="id"
        bindtap="goDetail" data-id="{{item.id}}">
    <view class="product-top">
      <image class="product-icon" src="{{item.icon}}" mode="aspectFit"></image>
      <view class="product-info">
        <view class="product-name">{{item.name}}</view>
        <view class="product-tagline">{{item.tagline}}</view>
      </view>
    </view>
    <view class="product-meta">
      <text class="product-price">¥{{item.price}}<text class="product-price-unit">/人</text></text>
      <view class="product-tags">
        <text class="product-tag">{{item.duration}}</text>
        <text class="product-tag">{{item.ageRange}}</text>
      </view>
    </view>
    <!-- 名额提示：有档期显示日期+余位，满员显示警示 -->
    <view class="quota-hint {{item.remaining > 0 ? 'quota-ok' : 'quota-full'}}">
      {{item.remaining > 0 ? '近期可约 ' + item.nextDate + ' · 余 ' + item.remaining + ' 位' : '近期档期已满 · 可关注后续更新'}}
    </view>
  </view>

  <view class="study-footer">研学预约流程：看到 → 报名，不超过 3 步</view>
</view>
