<!-- 互动统计页"家具摆放图" -->
<view class="form-page">

  <view class="stats-note">故事互动统计（真实读云聚合）：点赞 = story_likes 记录数，收藏 = user_favorites 记录数</view>

  <!-- 统计列表 -->
  <view class="card stats-card" wx:for="{{stats}}" wx:key="id">
    <view class="stats-title">{{item.title}}</view>
    <view class="stats-meta">
      <text class="text-secondary">{{item.type}} · {{item.time || '时间待补充'}}</text>
    </view>
    <view class="stats-nums">
      <view class="stats-num">
        <text class="stats-num-value">{{item.likeCount}}</text>
        <text class="stats-num-label">点赞</text>
      </view>
      <view class="stats-num">
        <text class="stats-num-value">{{item.favCount}}</text>
        <text class="stats-num-label">收藏</text>
      </view>
    </view>
  </view>

  <view class="empty-tip" wx:if="{{!loading && !stats.length}}">暂无故事数据</view>
  <view class="stats-sort" bindtap="sortByLikes">按点赞数排序</view>
  <view class="stats-note">提示：聚合统计依赖 story_likes / user_favorites 集合权限为"所有用户可读"</view>
</view>
