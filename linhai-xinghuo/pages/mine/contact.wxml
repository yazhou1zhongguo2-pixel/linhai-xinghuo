<!-- 联系客服页"家具摆放图" -->
<view class="contact">

  <!-- 联系方式 -->
  <view class="section-title">联系方式</view>
  <view class="card">
    <view class="contact-row" bindtap="callService">
      <text class="contact-label">客服电话</text>
      <text class="contact-value">400-000-0000（演示）</text>
    </view>
    <view class="contact-row">
      <text class="contact-label">服务时间</text>
      <text class="contact-value">每日 8:00 - 20:00</text>
    </view>
    <view class="contact-row">
      <text class="contact-label">项目邮箱</text>
      <text class="contact-value">hello@linhaixinghuo.cn（演示）</text>
    </view>
  </view>

  <!-- 问题反馈 -->
  <view class="section-title">问题反馈</view>
  <view class="card">
    <textarea class="feedback-input" placeholder="请描述你遇到的问题或建议（如：预约日期、物流、认养计划等）"
              value="{{feedback}}" bindinput="onInput" maxlength="300"></textarea>
    <view class="feedback-count">{{feedback.length}}/300</view>
    <button class="feedback-btn" bindtap="submit">提交反馈</button>
    <view class="pay-note">反馈会在 1-3 个工作日内处理（演示版仅本地保存）</view>
  </view>
</view>
