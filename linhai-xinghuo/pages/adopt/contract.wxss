/* 电子认养协议页样式 */
.contract {
  padding: 0 32rpx 60rpx;
}

/* 计划摘要 */
.contract-plan {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  background: linear-gradient(135deg, #24432F, #3A6B4E);
  border-radius: 24rpx;
  padding: 32rpx 36rpx;
  margin-top: 24rpx;
  color: #FFFFFF;
}
.contract-plan-name {
  font-size: 30rpx;
  font-weight: bold;
}
.contract-plan-price {
  font-size: 28rpx;
  color: #C9A96A;
}

/* 协议正文 */
.agreement {
  padding: 8rpx 32rpx;
}
.agree-clause {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0EBDF;
}
.agree-clause:last-child {
  border-bottom: none;
}
.agree-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #24432F;
  margin-bottom: 8rpx;
}
.agree-text {
  font-size: 24rpx;
  color: #5A544B;
  line-height: 1.7;
}

/* 同意勾选 */
.agree-check {
  display: flex;
  align-items: center;
  padding: 24rpx 8rpx;
}
.agree-box {
  width: 40rpx;
  height: 40rpx;
  border-radius: 10rpx;
  border: 2rpx solid #B7AE9E;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  font-size: 26rpx;
  color: #FFFFFF;
}
.agree-box-on {
  background-color: #3A6B4E;
  border-color: #3A6B4E;
}
.agree-check-text {
  font-size: 26rpx;
  color: #2F2B26;
}

/* 支付按钮 */
.pay-btn {
  background-color: #3A6B4E;
  color: #FFFFFF;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: bold;
}
.pay-btn::after {
  border: none;
}
.pay-note {
  text-align: center;
  font-size: 22rpx;
  color: #B7AE9E;
  margin-top: 16rpx;
}

/* 成功页 */
.contract-success {
  padding-top: 60rpx;
}
.success-icon-wrap {
  display: flex;
  justify-content: center;
  margin-bottom: 24rpx;
}
.success-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background-color: #3A6B4E;
  color: #FFFFFF;
  font-size: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.success-title {
  text-align: center;
  font-size: 40rpx;
  font-weight: bold;
  color: #24432F;
  font-family: 'Songti SC', 'STSong', 'SimSun', serif;
  margin-bottom: 32rpx;
}
.success-meta {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  border: 1rpx solid #E8E2D5;
  padding: 24rpx 32rpx;
}
.success-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  font-size: 26rpx;
  color: #2F2B26;
}
.success-amount {
  color: #C9A96A;
  font-weight: bold;
}
.success-tip {
  text-align: center;
  font-size: 24rpx;
  color: #8A847A;
  padding: 24rpx 0;
  line-height: 1.7;
}
.back-link {
  text-align: center;
  font-size: 26rpx;
  color: #3A6B4E;
  padding: 24rpx 0;
}

/* 支付弹窗 */
.pay-dialog {
  text-align: center;
  padding: 24rpx 16rpx 8rpx;
}

/* 自绘弹窗底部按钮：flex 均分 */
.pay-dialog-btn {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  font-size: 30rpx;
}
.pay-dialog-cancel {
  color: #8A847A;
}
.pay-dialog-confirm {
  color: #FFFFFF;
  background-color: #3A6B4E;
  font-weight: bold;
}
.pay-dialog-title {
  font-size: 28rpx;
  color: #2F2B26;
}
.pay-dialog-amount {
  font-size: 56rpx;
  font-weight: bold;
  color: #C9A96A;
  margin: 16rpx 0;
}
.pay-dialog-desc {
  font-size: 22rpx;
  color: #8A847A;
}
