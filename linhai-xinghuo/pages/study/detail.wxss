/* 研学详情页样式 */
.detail {
  padding: 0 32rpx 160rpx;   /* 底部留白给吸底预约栏 */
}

/* 头部 */
.detail-head {
  background: linear-gradient(135deg, #24432F, #3A6B4E);
  border-radius: 24rpx;
  padding: 40rpx 36rpx;
  margin-top: 24rpx;
  color: #FFFFFF;
}
.detail-name {
  font-size: 40rpx;
  font-weight: bold;
  font-family: 'Songti SC', 'STSong', 'SimSun', serif;
  margin-bottom: 8rpx;
}
.detail-tagline {
  font-size: 26rpx;
  color: #C9D8C8;
  margin-bottom: 20rpx;
}
.detail-price {
  font-size: 44rpx;
  font-weight: bold;
  color: #C9A96A;
}
.detail-price-unit {
  font-size: 24rpx;
  font-weight: normal;
  color: #C9D8C8;
}
.detail-tags {
  display: flex;
  margin-top: 20rpx;
}
.detail-tag {
  font-size: 22rpx;
  color: #FFFFFF;
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  border-radius: 8rpx;
  padding: 4rpx 14rpx;
  margin-right: 12rpx;
}

/* 一句话介绍 */
.detail-summary {
  font-size: 26rpx;
  color: #5A544B;
  line-height: 1.8;
  padding: 24rpx 8rpx;
}

/* 行程安排 */
.schedule-item {
  display: flex;
  align-items: baseline;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F0EBDF;
}
.schedule-item:last-child {
  border-bottom: none;
}
.schedule-day {
  font-size: 24rpx;
  font-weight: bold;
  color: #3A6B4E;
  width: 100rpx;
  flex-shrink: 0;
}
.schedule-time {
  font-size: 22rpx;
  color: #8A847A;
  width: 130rpx;
  flex-shrink: 0;
}
.schedule-item-name {
  font-size: 26rpx;
  color: #2F2B26;
}

/* 课程大纲 */
.curriculum-item {
  display: flex;
  align-items: baseline;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F0EBDF;
}
.curriculum-item:last-child {
  border-bottom: none;
}
.curriculum-num {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background-color: #F0EBDF;
  color: #3A6B4E;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 20rpx;
}
.curriculum-name {
  font-size: 26rpx;
  color: #2F2B26;
}

/* 师资 */
.teacher-top {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}
.teacher-photo {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background-color: #F0EBDF;
  margin-right: 20rpx;
}
.teacher-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #24432F;
}
.teacher-title {
  font-size: 22rpx;
  color: #8A847A;
  margin-top: 4rpx;
}
.teacher-intro {
  font-size: 24rpx;
  color: #5A544B;
  line-height: 1.7;
}

/* 评价 */
.review-head {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.review-author {
  font-size: 26rpx;
  font-weight: bold;
  color: #24432F;
}
.review-right {
  display: flex;
  align-items: center;
}
.review-cloud-tag {
  font-size: 20rpx;
  color: #C0392B;
  border: 1rpx solid #C0392B;
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
  margin-right: 12rpx;
}
.empty-tip {
  text-align: center;
  font-size: 24rpx;
  color: #B7AE9E;
  padding: 30rpx 0;
}
.review-content {
  font-size: 24rpx;
  color: #5A544B;
  line-height: 1.7;
}

/* 适龄建议 */
.suitability-card {
  font-size: 26rpx;
  color: #5A544B;
  line-height: 1.7;
}

/* 集合地点 */
.meet-name {
  font-size: 26rpx;
  color: #2F2B26;
  margin-bottom: 16rpx;
}
.meet-btn {
  text-align: center;
  font-size: 26rpx;
  color: #3A6B4E;
  background-color: #F0F5EC;
  border-radius: 14rpx;
  padding: 18rpx 0;
}

/* 档期名额 */
.date-row {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 8rpx;
  border-bottom: 1rpx solid #F0EBDF;
}
.date-row:last-child {
  border-bottom: none;
}
.date-label {
  font-size: 26rpx;
  color: #2F2B26;
}
.date-remaining {
  font-size: 24rpx;
  color: #3A6B4E;
}
.date-full {
  color: #C0392B;
}

/* 底部吸底预约栏 */
.book-bar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background-color: #FFFFFF;
  border-top: 1rpx solid #E8E2D5;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
}
.book-bar-price-num {
  font-size: 40rpx;
  font-weight: bold;
  color: #C9A96A;
}
.book-bar-price-unit {
  font-size: 22rpx;
  color: #8A847A;
}
.book-bar-btn {
  background-color: #3A6B4E;
  color: #FFFFFF;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: bold;
  padding: 0 60rpx;
}
.book-bar-btn::after {
  border: none;
}
