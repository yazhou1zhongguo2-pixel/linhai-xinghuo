/* 巡护记录上传页样式 */
.patrol {
  padding: 0 32rpx 60rpx;
}

/* 地块选择 */
.plot-chips {
  display: flex;
  flex-wrap: wrap;
}
.plot-chip {
  font-size: 26rpx;
  color: #5A544B;
  border: 2rpx solid #E8E2D5;
  border-radius: 30rpx;
  padding: 10rpx 28rpx;
  margin: 0 16rpx 16rpx 0;
  background-color: #FFFFFF;
}
.plot-chip-active {
  color: #FFFFFF;
  background-color: #3A6B4E;
  border-color: #3A6B4E;
}

/* 照片选择 */
.photo-picker {
  width: 320rpx;
  height: 240rpx;
  border-radius: 16rpx;
  overflow: hidden;
}
.photo-preview {
  width: 100%;
  height: 100%;
  display: block;
}
.photo-placeholder {
  width: 100%;
  height: 100%;
  background-color: #F0EBDF;
  border: 2rpx dashed #C9A96A;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.photo-plus {
  font-size: 64rpx;
  color: #B7AE9E;
  line-height: 1;
}
.photo-tip {
  font-size: 22rpx;
  color: #8A847A;
  margin-top: 12rpx;
}

/* 备注 */
.note-input {
  width: 100%;
  height: 220rpx;
  background-color: #FFFFFF;
  border: 1rpx solid #E8E2D5;
  border-radius: 14rpx;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

/* 提交 */
.submit-btn {
  margin-top: 32rpx;
  background-color: #3A6B4E;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: bold;
  border-radius: 16rpx;
}
.submit-btn::after {
  border: none;
}
.patrol-note {
  text-align: center;
  font-size: 22rpx;
  color: #B7AE9E;
  margin-top: 16rpx;
}

/* 样地日记 */
.record-card {
  padding: 28rpx 32rpx;
}
.record-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 12rpx;
}
.record-plot {
  font-size: 26rpx;
  font-weight: bold;
  color: #24432F;
}
.record-photo {
  width: 100%;
  height: 260rpx;
  border-radius: 14rpx;
  background-color: #F0EBDF;
  margin-bottom: 12rpx;
}
.record-note {
  font-size: 24rpx;
  color: #5A544B;
  line-height: 1.7;
}
.record-location {
  font-size: 20rpx;
  color: #B7AE9E;
  margin-top: 8rpx;
}
.empty-tip {
  text-align: center;
  font-size: 24rpx;
  color: #B7AE9E;
  padding: 40rpx 0;
}
