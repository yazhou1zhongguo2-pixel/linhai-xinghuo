/* 研学报名页样式 */
.book {
  padding: 0 32rpx 60rpx;
}

/* 产品摘要 */
.book-product {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  background: linear-gradient(135deg, #24432F, #3A6B4E);
  border-radius: 24rpx;
  padding: 32rpx 36rpx;
  margin-top: 24rpx;
  color: #FFFFFF;
}
.book-product-name {
  font-size: 30rpx;
  font-weight: bold;
}
.book-product-price {
  font-size: 28rpx;
  color: #C9A96A;
}

/* 日期选择（小方块阵列） */
.date-chips {
  display: flex;
  flex-wrap: wrap;
}
.date-chip {
  width: 196rpx;
  margin: 0 16rpx 16rpx 0;
  padding: 16rpx 0;
  text-align: center;
  border: 2rpx solid #E8E2D5;
  border-radius: 16rpx;
  background-color: #FFFFFF;
}
.date-chip-day {
  font-size: 26rpx;
  color: #2F2B26;
  margin-bottom: 6rpx;
}
.date-chip-remain {
  font-size: 20rpx;
  color: #3A6B4E;
}
/* 选中态：绿框 */
.date-chip-active {
  border-color: #3A6B4E;
  background-color: #F0F5EC;
}
/* 满员态：灰 + 划线感 */
.date-chip-full {
  border-color: #E8E2D5;
  background-color: #F5F2EA;
}
.date-chip-full .date-chip-day {
  color: #B7AE9E;
}
.date-chip-full .date-chip-remain {
  color: #C0392B;
}

/* 人数 */
.count-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.count-label {
  font-size: 26rpx;
  color: #2F2B26;
}

/* 表单 */
.form-card {
  padding: 8rpx 32rpx;
}
.form-card van-field {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F0EBDF;
}
.form-card van-field:last-child {
  border-bottom: none;
}

/* 合计与提交 */
.total-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 8rpx 8rpx 24rpx;
}
.total-amount {
  font-size: 36rpx;
  font-weight: bold;
  color: #C9A96A;
}
.submit-btn {
  background-color: #3A6B4E;
  color: #FFFFFF;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: bold;
}
.submit-btn::after {
  border: none;
}
.pay-note {
  text-align: center;
  font-size: 22rpx;
  color: #B7AE9E;
  margin-top: 16rpx;
}

/* 成功页 */
.book-success {
  padding-top: 60rpx;
}
.success-icon-wrap {
  display: flex;
  justify-content: center;
  margin-bottom: 24rpx;
}
.success-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background-color: #3A6B4E;
  color: #FFFFFF;
  font-size: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.success-title {
  text-align: center;
  font-size: 40rpx;
  font-weight: bold;
  color: #24432F;
  font-family: 'Songti SC', 'STSong', 'SimSun', serif;
  margin-bottom: 32rpx;
}
.success-meta {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  border: 1rpx solid #E8E2D5;
  padding: 24rpx 32rpx;
}
.success-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  font-size: 26rpx;
  color: #2F2B26;
}
.success-amount {
  color: #C9A96A;
  font-weight: bold;
}

/* 行前须知 */
.notice-row {
  display: flex;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #2F2B26;
  border-bottom: 1rpx solid #F0EBDF;
}
.notice-row:last-child {
  border-bottom: none;
}
.notice-label {
  width: 140rpx;
  flex-shrink: 0;
  color: #8A847A;
  font-size: 24rpx;
}

/* 支付弹窗内容 */
.pay-dialog {
  text-align: center;
  padding: 24rpx 16rpx 8rpx;
}

/* 自绘弹窗底部按钮：flex 均分，两个按钮一样宽 */
.pay-dialog-btn {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  font-size: 30rpx;
}
.pay-dialog-cancel {
  color: #8A847A;
}
.pay-dialog-confirm {
  color: #FFFFFF;
  background-color: #3A6B4E;
  font-weight: bold;
}
.pay-dialog-title {
  font-size: 28rpx;
  color: #2F2B26;
}
.pay-dialog-amount {
  font-size: 56rpx;
  font-weight: bold;
  color: #C9A96A;
  margin: 16rpx 0;
}
.pay-dialog-desc {
  font-size: 22rpx;
  color: #8A847A;
}
