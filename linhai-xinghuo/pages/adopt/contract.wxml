<!-- 电子认养协议页"家具摆放图" -->
<view class="contract" wx:if="{{plan}}">

  <block wx:if="{{!success}}">
    <!-- 计划摘要 -->
    <view class="contract-plan">
      <text class="contract-plan-name">{{plan.name}}</text>
      <text class="contract-plan-price">¥{{plan.price}}/{{plan.unit === '元/年' ? '年' : '株'}}</text>
    </view>

    <view class="demo-tag">价格仅做项目演示，不涉及提现、支付等交易行为</view>
    <!-- 协议正文（滚动阅读） -->
    <view class="section-title">电子认养协议</view>
    <view class="card agreement">
      <view class="agree-clause">
        <view class="agree-title">一、认养权益</view>
        <view class="agree-text">认养人按所选计划享有对应权益（见计划详情页），权益内容以认养年度为准。</view>
      </view>
      <view class="agree-clause">
        <view class="agree-title">二、费用与凭证</view>
        <view class="agree-text">认养费用为演示数据（不产生真实扣款），登记完成后生成电子认养证书与认养编号，作为权益凭证（演示）。</view>
      </view>
      <view class="agree-clause">
        <view class="agree-title">三、报告与推送</view>
        <view class="agree-text">项目方按季度向认养人推送图文生长报告；红松计划另附碳汇趣味报告。认养到期前 30 天推送续约提醒。</view>
      </view>
      <view class="agree-clause">
        <view class="agree-title">四、探访与采挖</view>
        <view class="agree-text">林下参计划含 5 年实地探访权益，探访需提前预约并服从林场安全安排；采挖归属权按计划约定执行。</view>
      </view>
      <view class="agree-clause">
        <view class="agree-title">五、说明</view>
        <view class="agree-text">本协议为演示用协议文本（影子版），不具法律效力，仅用于功能展示。</view>
      </view>
    </view>

    <!-- 已阅读并同意 -->
    <view class="agree-check" bindtap="toggleAgree">
      <view class="agree-box {{agreed ? 'agree-box-on' : ''}}">
        <text wx:if="{{agreed}}">✓</text>
      </view>
      <text class="agree-check-text">我已阅读并同意《电子认养协议》</text>
    </view>

    <button class="pay-btn" bindtap="submit">同意并登记 ¥{{plan.price}}（演示价）</button>
    <view class="pay-note">本流程为演示（影子版），仅用于功能展示，不产生任何真实扣款与资金往来</view>
  </block>

  <!-- 认养成功 -->
  <view class="contract-success" wx:if="{{success}}">
    <view class="success-icon-wrap"><view class="success-icon">✓</view></view>
    <view class="success-title">认养成功！</view>
    <view class="success-meta">
      <view class="success-row"><text class="text-secondary">认养编号</text><text>{{adoptionId}}</text></view>
      <view class="success-row"><text class="text-secondary">认养计划</text><text>{{plan.name}}</text></view>
      <view class="success-row"><text class="text-secondary">费用（演示）</text><text class="success-amount">¥{{paidAmount}}</text></view>
    </view>
    <view class="success-tip">你的专属认养主页已开通，季度生长报告将在这里推送</view>
    <button class="pay-btn" bindtap="goAdoptHome">查看我的专属认养主页</button>
    <view class="back-link" bindtap="goBackList">返回认养列表</view>
  </view>

  <!-- 影子支付确认（自绘等宽底部按钮，见 book 页同样式） -->
  <van-dialog use-slot show="{{showPay}}" show-cancel-button
              use-cancel-button-slot use-confirm-button-slot>
    <view class="pay-dialog">
      <view class="pay-dialog-title">确认登记认养信息</view>
      <view class="pay-dialog-amount">¥{{plan.price}}</view>
      <view class="pay-dialog-desc">演示版：点击"确认登记"即模拟完成流程，不产生真实扣款</view>
    </view>
    <view slot="cancel-button" class="pay-dialog-btn pay-dialog-cancel" bindtap="onPayCancel">再想想</view>
    <view slot="confirm-button" class="pay-dialog-btn pay-dialog-confirm" bindtap="confirmPay">确认登记</view>
  </van-dialog>
</view>
